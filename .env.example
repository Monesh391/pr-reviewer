# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=

# For cloud hosting, you can use the private key contents instead:
# GITHUB_PRIVATE_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Review settings ---
MIN_CONFIDENCE=0.7
MAX_COMMENTS=8
MAX_DIFF_CHARS=30000
MAX_FILES=20

# --- Cost tracking (USD per million tokens) ---
PRICE_PER_MTOK_INPUT=0
PRICE_PER_MTOK_OUTPUT=0