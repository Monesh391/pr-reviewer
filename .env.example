# --- GitHub App ---
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=choose-a-long-random-string
# Either a path to the .pem file...
GITHUB_PRIVATE_KEY_PATH=private-key.pem
# ...or the PEM contents with newlines written as \n (handy for cloud hosting)
# GITHUB_PRIVATE_KEY=

# --- LLM ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=YOUR_GEMINI_MODEL


# --- Tuning (optional) ---
MIN_CONFIDENCE=0.7
MAX_COMMENTS=8
MAX_DIFF_CHARS=30000
MAX_FILES=20
# USD per million tokens, used for the cost report. Update to match your model.
PRICE_PER_MTOK_INPUT=3.0
PRICE_PER_MTOK_OUTPUT=15.0
